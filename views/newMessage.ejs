<%- include("partials/head") %>
    <main>
        <% if (locals.errors) {%>
            <%- include('partials/errors') %>
        <% } %>
        <form action="/new-message" method="post">
            <h1>Post New Message</h1>
            <span class="input-span">
                <label for="title">Title:</label>
                <input type="text" id="title" name="title" placeholder=" " maxlength="100" required />
            </span>
            <span class="input-span">
                <label for="post">Message:</label>
                <textarea id="post" name="post" placeholder=" " minlength="10" required></textarea>
            </span>
            <button type="submit" class="submitButton">Post</button>
        </form>
    </main>
<%- include('partials/foot') %>